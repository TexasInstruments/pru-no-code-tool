export PRU_NO_CODE_TOOL_PATH?=$(abspath ../../../../../..)
include $(PRU_NO_CODE_TOOL_PATH)/imports.mak

PROFILE?=Release

PROJECT_NAME=empty_am243x-evm_icss_g0_pru0_fw_ti-pru-cgt

all:
	$(CCS_ECLIPSE) -noSplash -data $(PRU_NO_CODE_TOOL_PATH)/ccs_projects -application com.ti.ccstudio.apps.projectBuild -ccs.projects $(PROJECT_NAME) -ccs.configuration $(PROFILE)

clean:
	$(CCS_ECLIPSE) -noSplash -data $(PRU_NO_CODE_TOOL_PATH)/ccs_projects -application com.ti.ccstudio.apps.projectBuild -ccs.projects $(PROJECT_NAME) -ccs.configuration $(PROFILE) -ccs.clean

export:
	$(MKDIR) $(PRU_NO_CODE_TOOL_PATH)/ccs_projects
	$(CCS_ECLIPSE) -noSplash -data $(PRU_NO_CODE_TOOL_PATH)/ccs_projects -application com.ti.ccstudio.apps.projectCreate -ccs.projectSpec example.projectspec -ccs.overwrite full
