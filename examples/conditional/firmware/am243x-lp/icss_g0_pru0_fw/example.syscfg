load_constant_block4.constant1 = 255;
load_constant_block4.$name     = "original_data";

conditional_block1.$name            = "If_Else_0";
conditional_block1.conditionToCheck = "lessThanInput2";

/**
 * Connections between modules.
 */
scripting.connect(bitwise_block1, "input1", load_constant_block4, "output1");
scripting.connect(bitwise_block1, "input2", load_constant_block3, "output1");
scripting.connect(bitwise_block1, "prev", conditional_block1, "T");
scripting.connect(bitwise_block2, "input1", load_constant_block4, "output1");
scripting.connect(bitwise_block2, "input2", load_constant_block3, "output1");
scripting.connect(bitwise_block2, "prev", conditional_block1, "F");
scripting.connect(load_constant_block1, "output1", conditional_block1, "input2");
scripting.connect(load_constant_block2, "output1", conditional_block1, "input1");

/**
 * (x,y) coordinates for modules that are displayed in a graph.
 */
bitwise_block1.$position       = [465,5];
bitwise_block2.$position       = [465,160];
