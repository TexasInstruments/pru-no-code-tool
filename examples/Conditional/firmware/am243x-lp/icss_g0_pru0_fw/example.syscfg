scripting.connect(load_constant_block1, "output1", conditional_block1, "input2");
scripting.connect(load_constant_block2, "output1", conditional_block1, "input1");
scripting.connect(load_constant_block3, "prev", conditional_block1, "T");
scripting.connect(load_constant_block3, "next", load_constant_block4, "prev");
scripting.connect(load_constant_block5, "prev", load_constant_block6, "next");
scripting.connect(load_constant_block6, "prev", conditional_block1, "F");
