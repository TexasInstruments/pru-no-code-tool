;************************************************************************************
;   File:     pru_syscfg.asm
;
;   Brief:    sysconfig generated pru firmware
;************************************************************************************

    ;sysconfig_generated_start label should be invoked from main.asm to run sysconfig generated code
    .global     sysconfig_generated_start
    ;sysconfig_generated_end label should be defined in main.asm to transfer back control to main.asm
    .ref        sysconfig_generated_end

%let groupMetadata = system.getScript("/pru_blocks/common/register_allocation/pru_register_allocator.js").getGroupMetadata();
%if(groupMetadata && groupMetadata.length > 0){
    ;Group block start labels - can be called from main.asm
%for (let groupInfo of groupMetadata) {
    .global     `groupInfo.groupName`_start
%}
%}

;************************************* includes *************************************
    .include    "pru_syscfg.inc"

    .retain     ; Required for building .out with assembly file
    .retainrefs ; Required for building .out with assembly file

%let initSectDirectives = system.modules["/pru_blocks/common/pru_blocks_static_module"]?.getInitSectDirectives();
%if(initSectDirectives){
`initSectDirectives`
%}

;************************************************************************************
;   Uninitialized memory reservations (.usect)
;************************************************************************************
%let usectLinkerDirectives = system.modules["/pru_blocks/common/pru_blocks_static_module"]?.getUsectLinkerDirectives();
%if(usectLinkerDirectives && usectLinkerDirectives.length > 0){
%for (let directive of usectLinkerDirectives) {
`directive`
%}
%}

    .retain     ; Required for building .out with assembly file
    .retainrefs ; Required for building .out with assembly file
    .sect       ".text"
;**************************************************************************************
;                       syconfig_generated
;**************************************************************************************
%if(pruRegisterAllocationSummary && (Object.keys(systemModules).length > 0)){
%// Generate and insert register allocation summary comments
`registerAllocator.getRegisterAllocationComments()`
%}
%if(pruRegisterAllocationSummary && (Object.keys(systemModules).length > 0)){
%//PRU registers are allocated at validation stage, not required to call allocatePruRegisters
%let pruInstructions = pruRegisterAllocationSummary.pruInstructions;
%let labels = pruRegisterAllocationSummary.labels;
%let pruInstructionInstances = pruRegisterAllocationSummary.pruInstructionInstances;
%
%// Find the index where group sections start
%let groupStartIndex = pruInstructions.length; // Default to end if no groups
%if(groupMetadata && groupMetadata.length > 0){
%    let groupStartLabels = new Set(groupMetadata.map(g => `${g.groupName}_start`));
%    for(let i = 0; i < labels.length; i++) {
%        if(typeof(labels[i]) == "string" && groupStartLabels.has(labels[i])) {
%            groupStartIndex = i;
%            break;
%        }
%    }
%}
;**************************************************************************************
;                    PRU assembly code outside group block
;**************************************************************************************
sysconfig_generated_start:
%// First loop: Output ungrouped blocks (sysconfig_generated section)
%for(let iterator = 0; iterator < groupStartIndex; iterator++)
%{
%if(typeof(labels[iterator]) == "string" && labels[iterator] !== "")
%{
`labels[iterator]`:
%}
%    if((!pruInstructions[iterator].includes("-1")) && (pruInstructions[iterator] != "0") && (!pruInstructions[iterator].includes("undefined")))
%    {
    ;PRU Instruction of `pruInstructionInstances[iterator].$name`
    `pruInstructions[iterator]`
%    }
%}
    ;Incase program is reached here, halt so that code related to group blocks is not executed
    halt


;**************************************************************************************
;                 PRU assembly code of Group blocks
;**************************************************************************************
%// Second loop: Output grouped blocks (separate sections)
%for(let iterator = groupStartIndex; iterator < pruInstructions.length; iterator++)
%{
%if(typeof(labels[iterator]) == "string" && labels[iterator] !== "")
%{
`labels[iterator]`:
%}
%    if((!pruInstructions[iterator].includes("-1")) && (pruInstructions[iterator] != "0") && (!pruInstructions[iterator].includes("undefined")))
%    {
    ;PRU Instruction of `pruInstructionInstances[iterator].$name`
    `pruInstructions[iterator]`
%    }
%}
%}