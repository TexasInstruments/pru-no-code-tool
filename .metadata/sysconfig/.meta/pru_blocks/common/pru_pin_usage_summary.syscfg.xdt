%if(system.modules["/pru_blocks/common/pru_blocks_static_module"])
%{
%const pruRegisterAllocationSummary = system.getScript("/pru_blocks/common/register_allocation/pru_register_allocator.js").getPruRegisterAllocationSummary();
%const pruInstructionInstances = pruRegisterAllocationSummary.pruInstructionInstances;
%
%/**
% * Helper function to extract PRU number from system context
% * @returns {number} PRU number (0 or 1), defaults to 0 if cannot determine
% */
%function getPruNumberFromContext() {
%    const common = system.getScript("/common");
%    const coreName = common.getSelfSysCfgCoreName();
%
%    // coreName format: "icss_g0_pru0" or "icss_g0_pru1"
%	let result = 0;
%    if (coreName && coreName.includes("pru")) {
%        const match = coreName.match(/pru(\d+)$/);
%        if (match && match[1]) {
%            result=parseInt(match[1]);
%        }
%    }
%	if(result==0)return "PRU0";
%    return "PRU1";
%}
%const PRU_USED = getPruNumberFromContext();
%// Helper function to extract pins from an instance
%function getPinInfo(inst) {
%    const pins = [];
%    // Null-safety: check if inst and inst.$module exist
%    if (!inst || !inst.$module || !inst.$module.$name) {
%        return pins;  // Return empty array for invalid instances
%    }
%    const modulePath = inst.$module.$name;
%
%    // PRU GPO block
%    if (modulePath.includes("pru_gpo_block")) {
%        const match = inst.constant1?.match(/R30,\s*(\d+)/);
%        if (match) pins.push({ pin: match[1], func: "GPIO", dir: `${PRU_USED}_GPO` });
%    }
%    // PRU GPI block
%    else if (modulePath.includes("pru_gpi_block")) {
%        const match = inst.constant1?.match(/1\s*<<\s*(\d+)/);
%        if (match) pins.push({ pin: match[1], func: "GPIO", dir: `${PRU_USED}_GPI` });
%    }
%    // SPI Write block
%    else if (modulePath.includes("pru_spi_write")) {
%        const isCtrl = inst["Device Mode"] === "controller";
%        pins.push({ pin: inst["SCLK Signal"], func: "SCLK", dir: isCtrl ? `${PRU_USED}_GPO` : `${PRU_USED}_GPI` });
%        pins.push({ pin: inst["SDO Signal"], func: "SDO", dir: `${PRU_USED}_GPO` });
%        pins.push({ pin: inst["CS Signal"], func: "CS", dir: isCtrl ? `${PRU_USED}_GPO` : `${PRU_USED}_GPI` });
%    }
%    // SPI Read block
%    else if (modulePath.includes("pru_spi_read")) {
%        const isCtrl = inst["Device Mode"] === "controller";
%        pins.push({ pin: inst["SCLK Signal"], func: "SCLK", dir: isCtrl ? `${PRU_USED}_GPO` : `${PRU_USED}_GPI` });
%        pins.push({ pin: inst["SDI Signal"], func: "SDI", dir: `${PRU_USED}_GPI` });
%        pins.push({ pin: inst["CS Signal"], func: "CS", dir: isCtrl ? `${PRU_USED}_GPO` : `${PRU_USED}_GPI` });
%    }
%    // SPI Transfer block
%    else if (modulePath.includes("pru_spi_transfer")) {
%        const isCtrl = inst["Device Mode"] === "controller";
%        pins.push({ pin: inst["SCLK Signal"], func: "SCLK", dir: isCtrl ? `${PRU_USED}_GPO` : `${PRU_USED}_GPI` });
%        pins.push({ pin: inst["SDI Signal"], func: "SDI", dir: `${PRU_USED}_GPI` });
%        pins.push({ pin: inst["SDO Signal"], func: "SDO", dir: `${PRU_USED}_GPO` });
%        pins.push({ pin: inst["CS Signal"], func: "CS", dir: isCtrl ? `${PRU_USED}_GPO` : `${PRU_USED}_GPI` });
%    }
%    // UART Config block - covers pins for all enabled TX/RX channels
%    // TX op and RX op blocks share the same pins — only uart_config is the source of truth
%    else if (modulePath.includes("uart_config")) {
%        if (inst.enableTX) {
%            const ch = inst.txChannel;
%            const basePin = ch * 3;
%            pins.push({ pin: basePin,     func: "PERIF" + ch + "_CLK",  dir: `${PRU_USED}_GPO` });
%            pins.push({ pin: basePin + 1, func: "PERIF" + ch + "_DOUT", dir: `${PRU_USED}_GPO` });
%            pins.push({ pin: basePin + 2, func: "PERIF" + ch + "_OE",   dir: `${PRU_USED}_GPO` });
%        }
%        if (inst.enableRX) {
%            const ch = inst.rxChannel;
%            const rxPin = 9 + ch;
%            pins.push({ pin: rxPin, func: "PERIF" + ch + "_DIN", dir: `${PRU_USED}_GPI` });
%        }
%    }
%    // UART TX Op / UART RX Op — pins already covered by the paired uart_config instance above
%    return pins;
%}
%
%// Build a map: pin -> list of {block, func, dir}
%const pinToBlocks = {};
%for(let i = 0; i < pruInstructionInstances.length; i++) {
%    const inst = pruInstructionInstances[i];
%    // Skip null/undefined instances (defensive programming)
%    if (!inst) continue;
%    const pins = getPinInfo(inst);
%    for (const pinInfo of pins) {
%        const pinKey = pinInfo.dir + pinInfo.pin;
%        if (!pinToBlocks[pinKey]) {
%            pinToBlocks[pinKey] = [];
%        }
%        pinToBlocks[pinKey].push({
%            block: inst,
%            func: pinInfo.func,
%            dir: pinInfo.dir,
%            pin: pinInfo.pin
%        });
%    }
%}
%
%// Sort pins by direction (GPO first) then by pin number
%const sortedPins = Object.keys(pinToBlocks).sort((a, b) => {
%    const aDir = a.startsWith(`${PRU_USED}_GPO`) ? 0 : 1;
%    const bDir = b.startsWith(`${PRU_USED}_GPO`) ? 0 : 1;
%    if (aDir !== bDir) return aDir - bDir;
%    const aNum = parseInt(a.match(/\d+/)[0]);
%    const bNum = parseInt(b.match(/\d+/)[0]);
%    return aNum - bNum;
%});
%
**PRU PIN USAGE SUMMARY**

PIN | USED BY
-- | --
%for(const pinKey of sortedPins) {
%    const usages = pinToBlocks[pinKey];
%    const blockStr = usages.map(u => {
%        const ref = (typeof system.getReference === 'function') ? system.getReference(u.block) : null;
%        return ref ? "[" + u.block.$name + "](" + ref + ") (" + u.func + ")" : u.block.$name + " (" + u.func + ")";
%    }).join(", ");
`pinKey` | `blockStr`
%}
%}
