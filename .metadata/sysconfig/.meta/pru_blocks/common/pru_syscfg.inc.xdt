;************************************************************************************
;   File:     pru_syscfg.inc
;
;   Brief:    sysconfig generated pru macros
;************************************************************************************

;************************************* PRU/ICSSG definitions ************************
% // Extract ICSSG instance, SLICE, and PRU number from system context
% const common = system.getScript("/common");
% const coreName = common.getSelfSysCfgCoreName();
% // coreName format: "icss_g0_pru0" or "icss_g1_pru1"
% let icssgNum = 0;
% let pruNum = 0;
% if (coreName && coreName.includes("icss_g")) {
%     const match = coreName.match(/icss_g(\d+)_pru(\d+)$/);
%     if (match) {
%         icssgNum = parseInt(match[1]);
%         pruNum = parseInt(match[2]);
%     }
% }
; Define ICSSG instance, SLICE, and PRU symbols (if not already defined by compiler)
    .if    !$defined("ICSSG`icssgNum`")
ICSSG`icssgNum`      .set 1
    .endif
    .if    !$defined("PRU`pruNum`")
PRU`pruNum`        .set 1
    .endif
    .if    !$defined("SLICE`icssgNum`")
SLICE`icssgNum`      .set 1
    .endif

% // ;************************************* constants ************************************
% // TODO : review again to add constants

% const systemModules = system.modules;

% // ;************************************* includes *************************************
% // TODO : review again if external include files apart from sysconfig generated macros are required


;************************************* register definitions *************************
            .asg	R28,	   TEMP_REG1
            .asg	R29,	   TEMP_REG2
% // Define RET_ADDR0 as the dynamically allocated group return address register
% let groupMetadata = system.getScript("/pru_blocks/common/register_allocation/pru_register_allocator.js").getGroupMetadata();
% if (groupMetadata && groupMetadata.length > 0) {
%     const returnRegister = groupMetadata[0].returnRegister;
%     if (returnRegister) {
            .asg    `returnRegister`,    RET_ADDR0    ; Dynamically allocated return address register for group blocks
%     }
% }

;**********************************
;*    subroutine macros           *
;**********************************
% // Define CALL macro if group blocks exist
% if (groupMetadata && groupMetadata.length > 0) {
; CALL macro: Jump And Link pattern for subroutine calls
; Usage: CALL <label>
; Saves return address to RET_ADDR0 and jumps to label
CALL        .macro func
            jal     RET_ADDR0, func
            .endm
% }

;**********************************
;*    auto generated macros       *
;**********************************
% // Reuse systemModules from includes section above
% const processedOpCodes = new Set(); // Track already processed opCodes
% for (const moduleName in systemModules) {
%     const module = systemModules[moduleName];
%     
%     if (!module) {
%         continue;
%     }
%    
%     if (typeof system.modules[moduleName].getMacro === 'function') {
%         for (let i = 0; i < module.$instances.length; i++) {
%             let instance = module.$instances[i];
%             if (instance && instance["opCode"] && !processedOpCodes.has(instance["opCode"])) {


%                 // Add this opCode to the set of processed opCodes
%                 processedOpCodes.add(instance["opCode"]);
`system.modules[moduleName].getMacro("", instance["opCode"])`
%             }
%         }
%     }
% }