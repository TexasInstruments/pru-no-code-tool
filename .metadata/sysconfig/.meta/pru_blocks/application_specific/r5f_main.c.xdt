% const module = system.modules["/pru_blocks/application_specific/application_host_block"];
% const inst = module ? module.$instances[0] : null;
/*
 * Copyright (C) 2026 Texas Instruments Incorporated - http://www.ti.com/
 *
 * Generated by SysConfig - PRU No Code Tool
 * Host Application main.c
 */

#include <stdio.h>
#include <stdint.h>
#include <drivers/sciclient.h>
#include <drivers/ipc_notify.h>
#include <drivers/pruicss.h>
#include "ti_drivers_config.h"
#include "ti_drivers_open_close.h"
#include "ti_board_open_close.h"
#include "FreeRTOS.h"
#include "task.h"

% if (inst && inst.pru0FirmwareName) {
extern const uint32_t %= inst.pru0FirmwareName %[];
% }
% if (inst && inst.pru1FirmwareName) {
extern const uint32_t %= inst.pru1FirmwareName %[];
% }

% if (inst && inst.enableSciclient) {
void setup_sciclient() {
    int32_t status = SystemP_SUCCESS;
    /* Sciclient initialization */
    status = Sciclient_init(NULL);
    if (status != SystemP_SUCCESS) {
        printf("Sciclient init failed!\n");
    } else {
        printf("Sciclient initialized successfully.\n");
    }
}
% }

% if (inst && inst.enableIpcNotify) {
void setup_ipc() {
    /* IPC Notify initialization */
    int32_t status = IpcNotify_init();
    if (status != SystemP_SUCCESS) {
        printf("IPC Notify init failed!\n");
    } else {
        printf("IPC Notify initialized successfully.\n");
    }
}
% }

int main() {
    printf("Starting R5F Host Application...\n");

    Drivers_open();
    Board_driversOpen();

% if (inst && inst.enableSciclient) {
    setup_sciclient();
% }

% if (inst && inst.enableIpcNotify) {
    setup_ipc();
% }

    /* Open PRUICSS Driver and Load Firmware */
    PRUICSS_Handle gPruIcss0Handle = PRUICSS_open(CONFIG_PRU_ICSS0);
    int status = SystemP_SUCCESS;

% if (inst && inst.pru0FirmwareName) {
    PRUICSS_initMemory(gPruIcss0Handle, PRUICSS_DATARAM(PRUICSS_PRU0));
    status = PRUICSS_loadFirmware(gPruIcss0Handle, PRUICSS_PRU0, %= inst.pru0FirmwareName %, sizeof(%= inst.pru0FirmwareName %));
    if(status != SystemP_SUCCESS) printf("PRU0 firmware load failed!\n");
% }
% if (inst && inst.pru1FirmwareName) {
    PRUICSS_initMemory(gPruIcss0Handle, PRUICSS_DATARAM(PRUICSS_PRU1));
    status = PRUICSS_loadFirmware(gPruIcss0Handle, PRUICSS_PRU1, %= inst.pru1FirmwareName %, sizeof(%= inst.pru1FirmwareName %));
    if(status != SystemP_SUCCESS) printf("PRU1 firmware load failed!\n");
% }

    /*
     * Encoder Position Reading Loop
     * To interface with PRU IPC Shared Memory block:
     * 1. Map the PRU Shared RAM address to R5F memory space dynamically.
     * 2. Read the struct/variables.
     */
     
    const PRUICSS_HwAttrs *pruAttrs = (const PRUICSS_HwAttrs *)(((PRUICSS_Config *)gPruIcss0Handle)->hwAttrs);
    volatile uint32_t* pru_shared_ram = (volatile uint32_t*)(pruAttrs->sharedDramBase);
    
    while(1) {
        /* Read shared memory variables and compare */
        uint32_t encoder_1_pos = pru_shared_ram[0];
        uint32_t encoder_2_pos = pru_shared_ram[1];
        
        if (encoder_1_pos != encoder_2_pos) {
            /* Position mismatch logic */
        }
        vTaskDelay(pdMS_TO_TICKS(100));
    }

    Board_driversClose();
    Drivers_close();
    return 0;
}
